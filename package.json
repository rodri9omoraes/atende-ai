    "start": "electron main.js",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "auto-launch": "^5.0.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
